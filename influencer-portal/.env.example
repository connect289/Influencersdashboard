# Eduwit Influencer Portal: environment variables.
# Copy to .env.local for local development (git-ignored). Never commit real values.
# Local values come from `npm run db:start` (it prints the local URL and keys).

# --- Supabase -------------------------------------------------------------------------------------------------------
# Project API URL. Local: http://127.0.0.1:54421. Production: https://xlseqwgyjuqhktrguhyc.supabase.co (go-live only).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
# Publishable (anon) key. Safe in the browser; RLS protects every table.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service-role key. SERVER ONLY (jobs, webhooks, signed-out flows). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site -----------------------------------------------------------------------------------------------------------
# Public base URL of this app, used in emails, links and OAuth redirects. Production default: https://creators.eduwit.in
NEXT_PUBLIC_SITE_URL=http://localhost:3200
# Shared secret for /api/internal/* (pg_cron jobs) and /api/metrics/summary. At least 32 random characters
# (e.g. `openssl rand -hex 32`). The same value is stored in Supabase Vault as `inf_internal_key`.
INF_INTERNAL_API_KEY=
# Show "Continue with Google" (on|off). Turn on only after configuring the Google provider in Supabase Auth.
NEXT_PUBLIC_AUTH_GOOGLE=off
# Optional: restrict staff Google sign-in to one Google Workspace domain (e.g. eduwit.in). Staff still need a profile.
STAFF_GOOGLE_HD=

# --- Sending ----------------------------------------------------------------------------------------------------------
# Nothing leaves the system (email, WhatsApp) unless LIVE_MODE=on. Mock providers record messages in the database.
LIVE_MODE=off
# Email provider: mock | smtp | resend | brevo. Mock is refused in production.
EMAIL_PROVIDER=mock
# Sender shown on emails.
EMAIL_FROM=Eduwit Creators <creators@eduwit.in>
# SMTP (Google Workspace or local Mailpit at 127.0.0.1:54425 with SMTP_SECURE=off).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=off
SMTP_USER=
SMTP_PASSWORD=
# Resend API key (when EMAIL_PROVIDER=resend).
RESEND_API_KEY=
# Brevo API key (when EMAIL_PROVIDER=brevo).
BREVO_API_KEY=
# WhatsApp provider: mock | meta (Meta Cloud API, template messages). Use a portal notification number, not Witty's.
WHATSAPP_PROVIDER=mock
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_API_VERSION=v21.0

# --- Observability ----------------------------------------------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
