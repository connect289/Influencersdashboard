  "analytics": {
    "funnel": [
      {
        "key": "click",
        "label": "Clicked a link or opened a form",
        "match": [
          {
            "app": "web",
            "type": "funnel.%"
          },
          {
            "app": "influencer",
            "type": "click%"
          }
        ]
      },
      {
        "key": "turn",
        "label": "Talked to Witty",
        "match": [
          {
            "app": "witty",
            "type": "turn"
          }
        ]
