From 990b253b7c999befbf11454155a728eaf3e90a79 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 30 Oct 2026 22:11:36 +0000
Subject: [PATCH 04/16] website: runtime redirects back off when the database
 is unreachable (every page waited 1.5 s)

proxy.ts loads the admin redirect map before every page request. After a failed load the cache kept its old
timestamp, so the next request loaded again: while the database was unreachable or stalled (production stalled for
3 to 6 hours three times in two days) each page view waited for the 1.5 s fetch timeout. A failed load now keeps the
last good map and waits the normal 60 s before trying again.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01N9g7Xn7RWKaJF173G8V173
---
 website/web/lib/server/redirects.test.ts | 44 ++++++++++++++++++++++++
 website/web/lib/server/redirects.ts      |  4 ++-
 2 files changed, 47 insertions(+), 1 deletion(-)
 create mode 100644 website/web/lib/server/redirects.test.ts

diff --git a/website/web/lib/server/redirects.test.ts b/website/web/lib/server/redirects.test.ts
new file mode 100644
index 0000000..3b2fa70
--- /dev/null
+++ b/website/web/lib/server/redirects.test.ts
@@ -0,0 +1,44 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+
+vi.mock("server-only", () => ({}));
+const { findRedirect } = await import("./redirects");
+const { resetEnvCache } = await import("./env");
+
+const saved = process.env.SUPABASE_SECRET_KEY;
+afterEach(() => {
+  if (saved === undefined) delete process.env.SUPABASE_SECRET_KEY;
+  else process.env.SUPABASE_SECRET_KEY = saved;
+  resetEnvCache();
+  vi.unstubAllGlobals();
+  vi.useRealTimers();
+});
+
+describe("runtime redirects", () => {
+  it("keep the last good map and back off for a minute when the database is unreachable", async () => {
+    process.env.SUPABASE_SECRET_KEY = "test-secret-key-0123456789";
+    resetEnvCache();
+    vi.useFakeTimers({ toFake: ["Date"] });
+    vi.setSystemTime(new Date("2026-10-30T10:00:00Z"));
+    let up = true;
+    const fetch = vi.fn(async () => {
+      if (!up) throw new Error("timeout");
+      return new Response(JSON.stringify({ "/old": { to: "/new", code: 301 } }), { status: 200 });
+    });
+    vi.stubGlobal("fetch", fetch);
+
+    expect(await findRedirect("/old")).toEqual({ to: "/new", code: 301 });
+    expect(fetch).toHaveBeenCalledTimes(1);
+
+    // The map is 61 s old and the database stops answering: one failed load, then no new attempt for a minute.
+    up = false;
+    vi.setSystemTime(new Date("2026-10-30T10:01:01Z"));
+    for (let i = 0; i < 5; i++) expect(await findRedirect("/old")).toEqual({ to: "/new", code: 301 });
+    expect(fetch).toHaveBeenCalledTimes(2);
+
+    // A minute later it tries again and picks up the database once it is back.
+    up = true;
+    vi.setSystemTime(new Date("2026-10-30T10:02:02Z"));
+    expect(await findRedirect("/old/")).toEqual({ to: "/new", code: 301 });
+    expect(fetch).toHaveBeenCalledTimes(3);
+  });
+});
diff --git a/website/web/lib/server/redirects.ts b/website/web/lib/server/redirects.ts
index 25c210b..fa5672f 100644
--- a/website/web/lib/server/redirects.ts
+++ b/website/web/lib/server/redirects.ts
@@ -28,7 +28,9 @@ export async function findRedirect(pathname: string): Promise<{ to: string; code
       inflight ??= load();
       cache = { at: now, map: await inflight };
     } catch {
-      cache = cache ?? { at: now, map: {} }; // keep serving the last good map; never block pages on this
+      // Keep serving the last good map and try again only after a full interval: the proxy runs before every page, so
+      // while the database is unreachable each request would otherwise wait for the 1.5 s timeout.
+      cache = { at: now, map: cache?.map ?? {} };
     } finally {
       inflight = null;
     }
