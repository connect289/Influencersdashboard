# Eduwit One: names only, never values (spec §13). Values live in the build environment's secrets, in Vercel env for
# the app, and in Vault for what the database reads. Where two names are listed, the first is preferred and the second
# is the name the build environment already uses.

# Database (scripts/db/*.sh, through with-db.ts; never printed)
ONE_PROD_DB_URL=
ONE_STAGING_DB_URL=
# Where dump.sh writes production archives; must be outside the repository (default ~/eduwit-one-dumps)
ONE_DUMP_DIR=

# Vendors and apps (preflight; the app reads the same names in phase 4)
ONE_GITHUB_TOKEN=           # or GH_TOKEN / GITHUB_TOKEN
ONE_VERCEL_TOKEN=           # or VERCEL_TOKEN
ONE_CHATWOOT_TOKEN=         # or CHATWOOT_API_TOKEN
ONE_CHATWOOT_ACCOUNT_ID=    # or CHATWOOT_ACCOUNT_ID
ONE_N8N_BASE_URL=
ONE_N8N_API_KEY=
ONE_AWS_ACCESS_KEY_ID=      # or EDUWIT_AWS_ACCESS_KEY_ID
ONE_AWS_SECRET_ACCESS_KEY=  # or EDUWIT_AWS_SECRET_ACCESS_KEY
ONE_AWS_REGION=             # or EDUWIT_AWS_REGION
ONE_UPTIMEROBOT_KEY=        # or UPTIMEROBOT_API_KEY
ONE_EMAIL_KEY=              # or RESEND_API_KEY
ONE_B2B_READ_KEY=           # or B2B_READ_API_KEY
ONE_B2B_INTAKE_KEY=         # or B2B_INTAKE_TEST_KEY
ONE_WHATSAPP_TOKEN=
ONE_WHATSAPP_WABA_IDS=
ONE_META_TOKEN=
ONE_META_AD_ACCOUNT_ID=
ONE_ANTHROPIC_API_KEY=      # Claude only (D-078): a key from the Console org linked to the Max/Team plan's API credits

# Test identities (spec §10; synthetic tests stay disabled while empty)
ONE_TEST_MAILBOX=
ONE_WEBSITE_PREVIEW_URL=
# The test runner login and the tests' own senders (D-070). Usually saved on the Setup page (Vault) instead.
ONE_TEST_RUNNER_PASSWORD=
ONE_TEST_RUNNER_TOTP=       # the TOTP factor's base32 secret
ONE_TEST_PARTNER_SECRET=
ONE_TEST_WA_TOKEN=
