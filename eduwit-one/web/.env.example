# Eduwit One app (Vercel env): names only, never values (spec §13). Hosts, ids, thresholds and schedules are not here:
# they are read from one.settings at runtime and changed on the Settings page (spec standard 3).

# Bootstrap: how the app reaches schema one (service role, PostgREST with schema one exposed; D-047)
ONE_SUPABASE_URL=
ONE_SUPABASE_SERVICE_KEY=
# The bearer the database's job calls carry; the same value as Vault one_internal_key
ONE_INTERNAL_KEY=

# Vendor credentials: a client whose credential is empty is "not configured" and writes nothing (D-049)
ONE_VERCEL_TOKEN=
ONE_CHATWOOT_TOKEN=
ONE_N8N_API_KEY=
# Optional: n8n base URL when it differs from one.settings.hosts.n8n
ONE_N8N_BASE_URL=
ONE_WHATSAPP_TOKEN=

# Tests and previews only: "mock" makes every client answer from lib/clients/fixtures
ONE_CLIENT_MODE=
# Contract tests against the real vendors: ONE_CONTRACT=1 npm test
ONE_CONTRACT=
