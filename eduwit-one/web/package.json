{
  "name": "eduwit-one-web",
  "private": true,
  "type": "module",
  "description": "Eduwit One app: HTTP probes, alert sender, AI worker and UI. Vercel root directory.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev -p 3300",
    "build": "next build",
    "start": "next start -p 3300",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "fixtures:record": "node --env-file-if-exists=.env.local scripts/record-fixtures.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "ai:eval": "node --conditions=react-server --env-file-if-exists=.env.local scripts/ai-eval.ts",
    "gen:prompts": "node scripts/gen-prompts.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "15.5.28",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "9.39.5",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.18.13",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
