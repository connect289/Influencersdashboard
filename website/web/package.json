{
  "name": "eduwit-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test",
    "lh": "node scripts/lighthouse.mjs",
    "axe": "node scripts/axe.mjs",
    "record:concepts": "node scripts/record-concepts.mjs",
    "shoot": "node scripts/shoot.mjs",
    "db:start": "supabase --workdir .. start -x studio,imgproxy,edge-runtime,logflare,vector,supavisor",
    "db:reset": "supabase --workdir .. db reset",
    "db:test": "../scripts/db/test.sh",
    "db:seed:regen": "node ../scripts/db/make-seed.mjs",
    "db:snapshot:regen": "../scripts/db/make-min-snapshot.sh",
    "db:gate": "../scripts/db/build-replica.sh && ../scripts/db/apply-web-migrations.sh && ../scripts/db/test.sh postgresql://postgres:postgres@localhost:54330/postgres && ../scripts/db/check-shared-unchanged.sh && npm run db:reset && npm run db:test",
    "e2e:laptop": "playwright test --project=laptop"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.8.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.58.0",
    "motion": "^14.3.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.1.2",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "lighthouse": "^13.5.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.121.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
