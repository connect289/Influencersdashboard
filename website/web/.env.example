# Eduwit website — environment variables (names read by lib/server/env.ts). Copy to .env.local for local dev.
# Anything left empty switches its adapter to a mock (docs/SETUP_CHECKLIST.md). Never commit real values.

APP_ENV=local                       # local | test | preview | production
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (local stack: `npm run db:start` prints these; production values only at go-live — S-11)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secrets (32+ random bytes each; required in production)
WEB_SESSION_SECRET=
WEB_INTERNAL_KEY=
# Set automatically by Vercel Cron (accepted on /api/internal/* like WEB_INTERNAL_KEY)
CRON_SECRET=

# Email (S-12): console | smtp | resend. Local: smtp to Mailpit (127.0.0.1:54325, no auth)
EMAIL_PROVIDER=console
EMAIL_FROM="Eduwit <no-reply@eduwit.in>"
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
RESEND_API_KEY=

# Cloudflare Turnstile (S-13). Test keys that always pass: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# AI (S-14)
GEMINI_API_KEY=                     # Witty on the website (D-083); Google AI Studio key
WEB_GEMINI_BASE_URL=                # optional gateway for the Gemini API
ANTHROPIC_API_KEY=                  # alternative model provider
WEB_ANTHROPIC_BASE_URL=              # optional proxy/gateway for the Anthropic API
WEB_ADVISOR_PROVIDER=auto            # auto (Gemini, then Claude) | gemini | claude | mock (mock is refused on deployed sites)
WEB_ADVISOR_MOCK_TTFT_MS=0           # load tests only: simulated time to first token of the mock model

# Key-value store (S-15); empty = in-memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Analytics (S-16..S-18) — loaded only with consent
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=
META_CAPI_TEST_CODE=
NEXT_PUBLIC_CLARITY_ID=

# Observability (S-19)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Search Console (S-20)
GSC_SA_EMAIL=
GSC_SA_PRIVATE_KEY=
GSC_SITE_URL=

# Influencer Portal creator API (S-43); empty = mock provider
CREATOR_API_URL=

# Database protection under load (D-080)
WEB_DB_MAX_CONCURRENCY=16            # concurrent database calls per server instance
SUPABASE_READ_REPLICA_URL=           # optional read replica API URL for catalogue reads (S-54)
