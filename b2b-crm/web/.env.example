NEXT_PUBLIC_SUPABASE_URL=https://xlseqwgyjuqhktrguhyc.supabase.co
# Publishable (anon) key: safe in the browser, RLS and grants protect the data
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service role key: server only, never exposed. Used only to log sign-in attempts, check the lockout and record a
# student's unsubscribe from an email link.
SUPABASE_SERVICE_ROLE_KEY=
# Public URL of this app, used in password-reset links (never taken from request headers) and offered as the
# "CRM web address" in Notifications -> Providers, where students' unsubscribe links point (/u/<lead>/<token>, M34j)
NEXT_PUBLIC_SITE_URL=https://b2b.eduwit.in
