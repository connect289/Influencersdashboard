# Eduwit B2C CRM: environment. Copy to .env.local for local work; set the same names in Vercel (Production and Preview).
# Never commit real values.

# Supabase (staging first: mplbspysxmtohnlwpbti). Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://mplbspysxmtohnlwpbti.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Used for signed-out steps (sign-in log, lockout, the emailed code), the webhooks and the sync jobs.
SUPABASE_SERVICE_ROLE_KEY=

# This deployment's address (used in links; never taken from request headers).
NEXT_PUBLIC_SITE_URL=https://b2c.eduwit.in

# The database timers (pg_cron) call /api/internal/* with this key. Store the same value in Supabase Vault as
# b2c_internal_key, and the site URL in b2c.settings 'app' → base_url (README step 5). At least 32 characters.
B2C_INTERNAL_KEY=

# The B2B CRM link (docs/b2c-contract.md §0): API base URL, API key with scopes b2c, events, intake, and the webhook
# endpoint's signing secret (whsec_...). Without all three the sync jobs do nothing and /v1/handoffs answers 503.
B2B_API_URL=https://eduwit-b2b-crm.vercel.app
B2B_API_KEY=
B2B_SIGNING_SECRET=

# Real messages to students go out only when this is "on" AND Settings → live mode is on. Test leads never.
LIVE_MODE=off

# WhatsApp Cloud API, the Eduwit B2C number (audit §9). WHATSAPP_WABA_ID (the business account) is needed to submit
# marketing templates to Meta and sync their status and quality hourly.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# Sign-in codes and alerts by SMTP through Google Workspace (smtp-relay.gmail.com:587, or a mailbox with an app password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Eduwit CRM <no-reply@eduwit.in>

# Counsellors' own emails to students: a Google service account with domain-wide delegation for gmail.send (audit §8).
# Marketing email (Phase 2) goes from the mailbox in Settings → marketing_email through the same account; the reconcile
# job reads that mailbox's replies and bounces, so also add https://www.googleapis.com/auth/gmail.readonly to the delegation.
GOOGLE_SA_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
# Teams sync from Google Workspace (daily): the same service account, delegated to a Workspace admin, with scope
# https://www.googleapis.com/auth/admin.directory.user.readonly added to its domain-wide delegation.
GOOGLE_ADMIN_EMAIL=connect@eduwit.in

# Web push (alerts on counsellors' phones). Generate once: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:connect@eduwit.in

# Signs the links in marketing email (open pixel, click, "I'm interested", unsubscribe). At least 32 characters.
# If empty, B2C_INTERNAL_KEY is used. Changing it breaks the links in emails already sent.
LINK_SECRET=

# Reply classification (Phase 2): replies the buttons and keyword rules can't place go to Claude (model in Settings →
# nurture → classify_model). Only the reply text and the course are sent. Without a key they wait in Replies.
ANTHROPIC_API_KEY=
